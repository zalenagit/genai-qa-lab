# Copy this file to .env and fill in your values. Never commit .env.

# Which LLM the AI helpers use: gemini (cloud) or ollama (private, offline)
LLM_PROVIDER=gemini

# Gemini: create a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=paste-your-key-here
GEMINI_MODEL=gemini-3-flash-preview

# Ollama (private LLM): install from https://ollama.com, then run: ollama pull llama3.2
OLLAMA_MODEL=llama3.2
OLLAMA_URL=http://localhost:11434
